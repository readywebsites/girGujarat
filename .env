# ==============================================================================
# TRAVEL FIRST HOLIDAYS — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# On the Ubuntu VPS, copy this file to '/srv/girgujarat/backend/.env':
#   cp .env.example /srv/girgujarat/backend/.env
#   chmod 600 /srv/girgujarat/backend/.env
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Set DEBUG to False in production
DEBUG=False

# Generate a strong 64-character random key on your server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_secure_random_64_character_secret_key

# Allowed hosts: Includes the VPS public IP for initial testing, plus domains when ready
ALLOWED_HOSTS=157.173.218.111,localhost,127.0.0.1

# Trusted origins for CSRF protection:
# Use http:// for IP testing; add https://yourdomain.com once SSL is enabled
CSRF_TRUSTED_ORIGINS=http://157.173.218.111,http://127.0.0.1:8000

# Permitted origins for CORS headers
CORS_ALLOWED_ORIGINS=http://157.173.218.111,http://127.0.0.1:8000

# PostgreSQL Database Configuration (Localhost port 5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=girgujarat_db
DB_USER=girgujarat_user
DB_PASSWORD=replace_with_your_strong_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432
